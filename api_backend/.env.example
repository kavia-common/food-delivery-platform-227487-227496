# Backend configuration
# Copy to .env and fill values as needed.

# ---- Database ----
# Use the database container env vars if your platform injects them.
# Preferred: POSTGRES_URL (e.g. postgresql+asyncpg://user:pass@host:port/dbname)
BACKEND_DATABASE_URL=

# Optional: if you prefer composing your own URL in runtime environments
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# ---- Auth / JWT ----
# Generate a strong secret for production.
BACKEND_JWT_SECRET=change-me
BACKEND_JWT_ALGORITHM=HS256
BACKEND_JWT_EXPIRES_MINUTES=10080

# ---- CORS ----
# Comma-separated list of allowed origins for the web frontend (e.g. http://localhost:3000)
BACKEND_CORS_ORIGINS=*

# ---- Dev helpers ----
# When true, exposes a seed/reset endpoint guarded by this flag.
BACKEND_ENABLE_DEV_ADMIN=false
