# Backend configuration
# Copy to .env and fill values as needed.

# ---- Database ----
# Preferred: a full SQLAlchemy async URL.
# Example:
#   BACKEND_DATABASE_URL=postgresql+asyncpg://appuser:dbuser123@localhost:5001/myapp
BACKEND_DATABASE_URL=

# If your environment injects the database container vars, you can use POSTGRES_URL directly
# (NOTE: api_backend expects an async driver URL; POSTGRES_URL may be used as-is only if it already includes +asyncpg)
POSTGRES_URL=

# Or provide individual connection parts (either POSTGRES_* or DB_*):
POSTGRES_HOST=localhost
POSTGRES_PORT=5001
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Auth / JWT ----
# Generate a strong secret for production.
BACKEND_JWT_SECRET=change-me
BACKEND_JWT_ALGORITHM=HS256
BACKEND_JWT_EXPIRES_MINUTES=10080

# ---- CORS ----
# Comma-separated list of allowed origins for the web frontend (e.g. http://localhost:3000)
BACKEND_CORS_ORIGINS=*

# ---- Dev helpers ----
# When true, exposes a seed/reset endpoint guarded by this flag.
BACKEND_ENABLE_DEV_ADMIN=false
